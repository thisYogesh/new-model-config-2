{% if section.blocks.size > 1 %}
  {% if section.settings.display_mode == 'full_frame' %}
    {% assign autoplay = section.settings.autoplay %}
  {% else %}
    {% assign autoplay = false %}
  {% endif %}
  {% capture controls %}
    {%- render 'slideshow-controls',
      style: section.settings.slideshow_controls_style,
      autoplay: autoplay,
      item_count: section.blocks.size,
      show_arrows: false,
      arrows_on_media: true,
      controls_on_media: true,
      pagination_position: 'center',
      icon_style: section.settings.icons_style
    -%}
  {% endcapture %}
{% endif %}

{% capture slides %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign section_width_class = ''
  if section.settings.display_mode == 'with_hints'
    assign section_width_class = 'section--page-width'
    if section.settings.full_frame_on_mobile
      assign section_width_class = section_width_class | append: ' section--mobile-full-width'
    endif
  else
    assign section_width_class = 'section--' | append: section.settings.section_width
  endif

  assign slideshow_class = 'slideshow--content-' | append: section.settings.content_position
  if section.blocks.size == 1
    assign slideshow_class = slideshow_class | append: ' slideshow--single-media'
  endif
  if section.settings.display_mode == 'with_hints'
    assign slideshow_class = slideshow_class | append: ' slideshow--with-hints'
    if section.settings.full_frame_on_mobile
      assign slideshow_class = slideshow_class | append: ' slideshow--with-hints--mobile-full-frame'
    else
      assign slideshow_class = slideshow_class | append: ' slideshow--with-hints--mobile-with-hints'
    endif
  endif

  assign show_arrows = true
  if section.settings.icons_style == 'none' or section.blocks.size <= 1
    assign show_arrows = false
  endif

  assign rounded_slide_corners = false
  if section.settings.display_mode == 'full_frame' and section.settings.section_width == 'page-width'
    assign rounded_slide_corners = true
  elsif section.settings.display_mode == 'with_hints' and section.settings.full_frame_on_mobile == false
    assign rounded_slide_corners = true
  endif

  assign beside_media_style = ''
  if section.settings.content_position == 'beside-media'
    if section.settings.media_position == 'left'
      assign beside_media_style = ' --media-order: 1; --content-order: 2; --media-padding-inline-start: 48px; --media-padding-inline-end: 16px; --controls-inline-start: auto; --controls-inline-end: 0;'
    else
      assign beside_media_style = ' --media-order: 2; --content-order: 1; --media-padding-inline-start: 16px; --media-padding-inline-end: 48px; --controls-inline-start: 0; --controls-inline-end: auto;'
    endif
    if section.settings.pagination_color != blank
      assign pagination_color_var = ' --slideshow-pagination-color: ' | append: section.settings.pagination_color | append: ';'
      assign beside_media_style = beside_media_style | append: pagination_color_var
    endif
  endif
%}

{% liquid
  if section.settings.background_color != blank
    assign skip_section_contrast = false
    if section.settings.content_position == 'on-media'
      assign skip_section_contrast = true
    endif
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: skip_section_contrast
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="slideshow-section spacing-style section {{ section_width_class }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} disable-section-top-offset"
  style="{% render 'spacing-padding', settings: section.settings %}; --slideshow-gap: {{ section.settings.slideshow_gap }}px;{% if rounded_slide_corners %} --corner-radius: {{ section.settings.corner_radius }}px;{% endif %}{{ beside_media_style }}"
>
  <h2 class="visually-hidden">{{ 'accessibility.slideshow' | t }}</h2>
  {% render 'slideshow',
    class: slideshow_class,
    controls: controls,
    show_arrows: show_arrows,
    icon_style: section.settings.icons_style,
    icon_shape: section.settings.icons_shape,
    autoplay: autoplay,
    autoplay_speed: section.settings.autoplay_speed,
    slides: slides,
    slide_count: section.blocks.size,
    slide_size: section.settings.slide_height
  %}
</div>

{% stylesheet %}
  .slideshow-section {
    slideshow-arrows .slideshow-control:first-of-type {
      margin-inline-start: var(--padding-xs);
    }

    slideshow-arrows .slideshow-control:last-of-type {
      margin-inline-end: var(--padding-xs);
    }

    .slideshow--with-hints--mobile-with-hints {
      gap: var(--slideshow-gap, 0);
      grid-column: 1 / -1;
    }

    /* Hide navigation arrows at boundaries for with-hints mode */
    .slideshow--with-hints--mobile-with-hints slideshow-arrows .slideshow-control {
      transition: opacity 0.3s ease;
    }

    /* Override animation for boundary arrows in with-hints mode on hover */
    slideshow-component.slideshow--with-hints--mobile-with-hints:has(
        slideshow-slide:first-child:not([aria-hidden='true'])
      )
      > slideshow-container
      > slideshow-arrows
      .slideshow-control--previous,
    slideshow-component.slideshow--with-hints--mobile-with-hints:has(
        slideshow-slide:last-child:not([aria-hidden='true'])
      )
      > slideshow-container
      > slideshow-arrows
      .slideshow-control--next {
      animation: none;
      opacity: 0;
      pointer-events: none;
    }

    @media screen and (max-width: 749px) {
      .slideshow--with-hints--mobile-with-hints slideshow-slides {
        padding-inline: var(--page-margin);
      }

      .slideshow--with-hints--mobile-with-hints slideshow-slide {
        width: 96%;
      }

      .slideshow--with-hints--mobile-with-hints slideshow-slides {
        gap: min(var(--slideshow-gap, 0), 10px);
      }
    }

    @media screen and (min-width: 750px) {
      .slideshow--with-hints {
        gap: var(--slideshow-gap, 0);
        grid-column: 1 / -1;
      }

      .slideshow--with-hints slideshow-slides {
        padding-inline: var(--page-margin);
        gap: var(--slideshow-gap, 0);
      }

      .slideshow--with-hints slideshow-slide {
        width: calc((100vw - var(--page-margin) * 2));
        overflow: hidden;
      }

      .slideshow--with-hints slideshow-arrows .slideshow-control {
        transition: opacity 0.3s ease;
      }

      slideshow-component.slideshow--with-hints:has(slideshow-slide:first-child:not([aria-hidden='true']))
        > slideshow-container
        > slideshow-arrows
        .slideshow-control--previous,
      slideshow-component.slideshow--with-hints:has(slideshow-slide:last-child:not([aria-hidden='true']))
        > slideshow-container
        > slideshow-arrows
        .slideshow-control--next {
        animation: none;
        opacity: 0;
        pointer-events: none;
      }
    }

    /*
     * Beside media (split) layout.
     * Scoped to .slideshow--content-beside-media so the on-media / below-media
     * layouts are untouched.
     */
    .slideshow--content-beside-media slideshow-slide {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      align-items: center;
    }

    .slideshow--content-beside-media slideshow-slide > .slide__image-container {
      position: relative;
      display: block;
      order: 1;
      width: 100%;
      height: auto;
      padding-inline: 30px;
    }

    .slideshow--content-beside-media .slide__image-container > :is(.slide__image, .slide__video, .slide__video-poster) {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }

    .slideshow--content-beside-media .slide__content {
      order: 2;

      /* Reserve room for the absolutely positioned pagination dots. */
      padding-block-end: calc(var(--padding-block-end, 0px) + 70px);
    }

    .slideshow--content-beside-media .slide__content h2 {
      font-size: 40px;
      line-height: 40px;
      letter-spacing: -1.2px;
    }

    .slideshow--content-beside-media .slide__content p {
      line-height: 20px;
    }

    .slideshow--content-beside-media slideshow-controls:has(> .slideshow-controls__dots) {
      mix-blend-mode: normal;
    }

    .slideshow--content-beside-media slideshow-controls[controls-on-media][pagination-position='center'] {
      width: 100%;
      inset-inline-start: 0;
      inset-inline-end: 0;
      bottom: 0;
    }

    .slideshow--content-beside-media .slideshow-controls__dots {
      gap: 6px;
      padding: 12px 16px;
    }

    .slideshow--content-beside-media .slideshow-controls__dots button {
      --size: 6px;
      --color: var(--slideshow-pagination-color, #f1e8da);
      --color-active: var(--slideshow-pagination-color, #f1e8da);
      --color-hover: var(--slideshow-pagination-color, #f1e8da);

      height: var(--size);
    }

    .slideshow--content-beside-media .slideshow-controls__dots button::after {
      flex: none;
      box-shadow: none;
      opacity: 0.4;
    }

    .slideshow--content-beside-media .slideshow-controls__dots button[aria-selected='true'] {
      width: 24px;
    }

    .slideshow--content-beside-media .slideshow-controls__dots button[aria-selected='true']::after {
      width: 18px;
      border-radius: 3px;
      opacity: 1;
    }

    @media screen and (min-width: 750px) {
      .slideshow--content-beside-media slideshow-slide {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto;
        align-items: stretch;
      }

      .slideshow--content-beside-media slideshow-slide > .slide__image-container {
        order: var(--media-order, 2);
        align-self: center;
        padding-inline: var(--media-padding-inline-start, 16px) var(--media-padding-inline-end, 48px);
      }

      .slideshow--content-beside-media
        .slide__image-container
        > :is(.slide__image, .slide__video, .slide__video-poster) {
        aspect-ratio: 656 / 624;
      }

      .slideshow--content-beside-media .slide__content {
        order: var(--content-order, 1);
      }

      .slideshow--content-beside-media .slide__content h2 {
        font-size: inherit;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      .slideshow--content-beside-media slideshow-controls[controls-on-media][pagination-position='center'] {
        width: 50%;
        inset-inline-start: var(--controls-inline-start, 0);
        inset-inline-end: var(--controls-inline-end, auto);
        bottom: 48px;
      }

      .slideshow--content-beside-media .slideshow-controls__dots {
        gap: 8px;
        padding: 16px 24px;
      }

      .slideshow--content-beside-media .slideshow-controls__dots button {
        --size: 8px;
      }

      .slideshow--content-beside-media .slideshow-controls__dots button[aria-selected='true'] {
        width: 32px;
      }

      .slideshow--content-beside-media .slideshow-controls__dots button[aria-selected='true']::after {
        width: 24px;
        border-radius: 4px;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
