{% comment %}
  Section Rendering API target only. Fetched by assets/cart-options-drawer.js on a product URL
  (`/products/handle?section_id=cart-options-drawer-content`), so `product` is in scope.
  Never merchant-addable — see the schema's disabled_on.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_selling_plans = false
  if product.selling_plan_groups.size > 0
    assign has_selling_plans = true
    assign first_plan = product.selling_plan_groups.first.selling_plans.first
    assign first_adjustment = first_plan.price_adjustments.first
    assign plan_pct = nil
    if first_adjustment.value_type == 'percentage'
      assign plan_pct = first_adjustment.value
    endif
  endif
-%}

<div
  class="cart-options-drawer__body"
  data-money-format="{{ shop.money_format | escape }}"
>
  <form
    class="cart-options-drawer__form"
    on:submit="#cart-options-drawer/handleSubmit"
    ref="form"
    novalidate
  >
    <div class="cart-options-drawer__product">
      <div class="cart-options-drawer__thumb">
        {%- if product.featured_image -%}
          {{
            product.featured_image
            | image_url: width: 144
            | image_tag: loading: 'lazy', alt: product.featured_image.alt, class: 'cart-options-drawer__thumb-image', width: 72, height: 72
          }}
        {%- endif -%}
      </div>
      <div class="cart-options-drawer__product-info">
        <p class="cart-options-drawer__title">{{ product.title }}</p>
        <p class="cart-options-drawer__prices">
          <span
            class="cart-options-drawer__price"
            ref="price"
          >
            {{- current_variant.price | money -}}
          </span>
          <s
            class="cart-options-drawer__compare"
            ref="comparePrice"
            {% unless current_variant.compare_at_price > current_variant.price %}
              hidden
            {% endunless %}
          >
            {%- if current_variant.compare_at_price > current_variant.price -%}
              {{- current_variant.compare_at_price | money -}}
            {%- endif -%}
          </s>
        </p>
      </div>
    </div>

    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        <fieldset class="cart-options-drawer__option">
          <legend class="cart-options-drawer__legend">{{ option.name }}</legend>
          <div class="cart-options-drawer__pills">
            {%- for value in option.values -%}
              <label class="cart-options-drawer__pill">
                <input
                  type="radio"
                  class="cart-options-drawer__pill-input visually-hidden"
                  name="option-{{ forloop.parentloop.index }}"
                  value="{{ value | escape }}"
                  on:change="#cart-options-drawer/handleOptionChange"
                  {% if option.selected_value == value %}
                    checked
                  {% endif %}
                >
                <span class="cart-options-drawer__pill-label">{{ value }}</span>
              </label>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endfor -%}
    {%- endunless -%}

    {%- if has_selling_plans -%}
      <fieldset class="cart-options-drawer__option cart-options-drawer__purchase">
        <legend class="cart-options-drawer__legend">Purchase type</legend>
        <label class="cart-options-drawer__radio">
          <input
            type="radio"
            name="purchase_type"
            value="one-time"
            on:change="#cart-options-drawer/handleOptionChange"
            {% unless product.requires_selling_plan %}
              checked
            {% endunless %}
            {% if product.requires_selling_plan %}
              disabled
            {% endif %}
          >
          <span>One-time purchase</span>
        </label>
        <label class="cart-options-drawer__radio">
          <input
            type="radio"
            name="purchase_type"
            value="subscribe"
            on:change="#cart-options-drawer/handleOptionChange"
            {% if product.requires_selling_plan %}
              checked
            {% endif %}
          >
          <span>
            {{- settings.cart_subscription_label -}}
            {%- if plan_pct != blank %} - {{ plan_pct }}% off{% endif -%}
          </span>
        </label>
        <label class="cart-options-drawer__plan">
          <span class="cart-options-drawer__plan-label">Auto-delivery every</span>
          <select
            name="selling_plan"
            class="cart-options-drawer__select"
            ref="planSelect"
            {% unless product.requires_selling_plan %}
              disabled
            {% endunless %}
          >
            {%- for group in product.selling_plan_groups -%}
              {%- for plan in group.selling_plans -%}
                <option value="{{ plan.id }}">{{ plan.name }}</option>
              {%- endfor -%}
            {%- endfor -%}
          </select>
        </label>
      </fieldset>
    {%- endif -%}

    <div class="cart-options-drawer__quantity">
      <span class="cart-options-drawer__legend">Quantity</span>
      <input
        type="number"
        name="quantity"
        class="cart-options-drawer__quantity-input"
        min="1"
        value="1"
        inputmode="numeric"
        aria-label="Quantity"
        ref="quantity"
      >
    </div>

    <input
      type="hidden"
      name="id"
      ref="variantId"
      value="{{ current_variant.id }}"
    >

    <script
      type="application/json"
      ref="variantData"
    >
      {{ product.variants | json }}
    </script>

    <p
      class="cart-options-drawer__error"
      ref="error"
      role="alert"
    ></p>

    <button
      type="submit"
      class="cart-options-drawer__submit"
      ref="submit"
      {% unless current_variant.available %}
        disabled
      {% endunless %}
    >
      <span ref="submitLabel">
        {%- if current_variant.available -%}
          Add | {{ current_variant.price | money }}
        {%- else -%}
          Sold out
        {%- endif -%}
      </span>
    </button>
  </form>
</div>

{% stylesheet %}
  .cart-options-drawer__body {
    --cart-drawer-ink: #231f20;
    --cart-drawer-accent: #14495b;
    --cart-drawer-cta: #9bd7d7;
    --cart-drawer-surface: #fcf9f5;
    --cart-drawer-thumb-bg: #f1e8da;
    --cart-drawer-border: #e0e6ed;
    --cart-drawer-muted: #656363;

    color: var(--cart-drawer-ink);
  }

  .cart-options-drawer__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cart-options-drawer__product {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .cart-options-drawer__thumb {
    flex: none;
    width: 72px;
    height: 72px;
    overflow: hidden;
    background: var(--cart-drawer-thumb-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-options-drawer__thumb-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cart-options-drawer__product-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cart-options-drawer__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 20px;
    font-weight: 500;
    overflow-wrap: break-word;
  }

  .cart-options-drawer__prices {
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 14px;
    line-height: 16px;
  }

  .cart-options-drawer__price {
    font-weight: 600;
  }

  .cart-options-drawer__compare {
    font-weight: 500;
    text-decoration: line-through;
  }

  .cart-options-drawer__option {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: none;
    min-width: 0;
  }

  .cart-options-drawer__legend {
    padding: 0;
    margin: 0;
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
  }

  .cart-options-drawer__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cart-options-drawer__pill {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  .cart-options-drawer__pill-label {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--cart-drawer-border);
    background: #ffffff;
    color: var(--cart-drawer-ink);
    font-size: 14px;
    line-height: 16px;
    font-weight: 500;
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);
  }

  .cart-options-drawer__pill-input:checked + .cart-options-drawer__pill-label {
    background: var(--cart-drawer-accent);
    border-color: var(--cart-drawer-accent);
    color: var(--cart-drawer-surface);
  }

  .cart-options-drawer__pill-input:focus-visible + .cart-options-drawer__pill-label {
    outline: 2px solid var(--cart-drawer-accent);
    outline-offset: 2px;
  }

  .cart-options-drawer__radio {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    line-height: 16px;
    font-weight: 600;
    cursor: pointer;
  }

  .cart-options-drawer__radio input {
    accent-color: var(--cart-drawer-accent);
    margin: 0;
  }

  .cart-options-drawer__plan {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cart-options-drawer__plan-label {
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    color: var(--cart-drawer-muted);
  }

  .cart-options-drawer__select {
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--cart-drawer-border);
    background: #ffffff;
    color: var(--cart-drawer-ink);
    font-size: 14px;
    line-height: 16px;
  }

  .cart-options-drawer__select:disabled {
    opacity: 0.5;
  }

  .cart-options-drawer__quantity {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cart-options-drawer__quantity-input {
    width: 128px;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--cart-drawer-border);
    background: #ffffff;
    color: var(--cart-drawer-ink);
    font-size: 16px;
    line-height: 20px;
    font-weight: 500;
    text-align: center;
  }

  .cart-options-drawer__error {
    margin: 0;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-error, #b3261e);
  }

  .cart-options-drawer__error:empty {
    display: none;
  }

  .cart-options-drawer__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 12px 24px;
    border: none;
    border-radius: 0;
    background: var(--cart-drawer-cta);
    color: var(--cart-drawer-ink);
    font-family: var(--font-subheading--family);
    font-size: 14px;
    line-height: 16px;
    font-weight: 600;
    cursor: pointer;
  }

  .cart-options-drawer__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart options drawer content",
  "settings": [],
  "disabled_on": {
    "groups": ["*"],
    "templates": ["*"]
  }
}
{% endschema %}
