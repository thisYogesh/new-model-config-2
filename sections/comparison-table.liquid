{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign brand_blocks = section.blocks | where: 'type', 'brand'
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style comparison-table{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {% if section.settings.heading != blank %}
    <h2 class="comparison-table__heading h2">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if brand_blocks.size > 0 %}
    <div class="comparison-table__scroll">
      <table class="comparison-table__table">
        <thead>
          <tr class="comparison-table__row comparison-table__row--brands">
            <th scope="col" class="comparison-table__cell comparison-table__cell--label">
              <span class="visually-hidden">Feature</span>
            </th>
            {% for block in brand_blocks %}
              {% assign logo_opacity = block.settings.logo_opacity | default: 100 | divided_by: 100.0 %}
              <th
                scope="col"
                class="comparison-table__cell comparison-table__cell--brand{% if block.settings.highlight %} comparison-table__cell--highlight{% endif %}"
                style="--comparison-table-logo-width: {{ block.settings.logo_width | default: 72 }}px; --comparison-table-logo-opacity: {{ logo_opacity }};"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.logo != blank %}
                  {{
                    block.settings.logo
                    | image_url: width: 400
                    | image_tag:
                      class: 'comparison-table__logo',
                      alt: block.settings.logo_alt,
                      loading: 'lazy',
                      widths: '100,200,400'
                  }}
                {% elsif block.settings.logo_svg != blank %}
                  <img
                    class="comparison-table__logo"
                    src="{{ block.settings.logo_svg | asset_url }}"
                    alt="{{ block.settings.logo_alt | escape }}"
                    width="{{ block.settings.logo_width | default: 72 }}"
                    loading="lazy"
                  >
                {% else %}
                  <span class="comparison-table__brand-name">{{ block.settings.logo_alt }}</span>
                {% endif %}
              </th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% if section.settings.format_label != blank %}
            <tr class="comparison-table__row comparison-table__row--format">
              <th scope="row" class="comparison-table__cell comparison-table__cell--label">
                {{ section.settings.format_label }}
              </th>
              {% for block in brand_blocks %}
                <td class="comparison-table__cell comparison-table__cell--format{% if block.settings.highlight %} comparison-table__cell--highlight{% endif %}">
                  {{ block.settings.format | escape | newline_to_br }}
                </td>
              {% endfor %}
            </tr>
          {% endif %}

          {% for feature in feature_blocks %}
            {% assign feature_index = forloop.index0 %}
            <tr class="comparison-table__row comparison-table__row--feature" {{ feature.shopify_attributes }}>
              <th scope="row" class="comparison-table__cell comparison-table__cell--label">
                {{ feature.settings.label }}
              </th>
              {% for block in brand_blocks %}
                {% assign results = block.settings.results | split: ',' %}
                {% assign result = results[feature_index] | strip | downcase %}
                <td class="comparison-table__cell comparison-table__cell--result{% if block.settings.highlight %} comparison-table__cell--highlight{% endif %}">
                  {% if result == 'yes' %}
                    <svg class="comparison-table__icon comparison-table__icon--yes" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
                      <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="visually-hidden">Yes</span>
                  {% else %}
                    <svg class="comparison-table__icon comparison-table__icon--no" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
                      <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <span class="visually-hidden">No</span>
                  {% endif %}
                </td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .comparison-table__heading {
    margin-block: 0 var(--gap-lg);
    text-align: center;
  }

  .comparison-table__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .comparison-table__table {
    width: 100%;
    min-width: 640px;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }

  .comparison-table__cell {
    padding-block: var(--gap-sm);
    padding-inline: var(--gap-xs);
    border-block-end: 1px solid var(--color-border);
    text-align: center;
    vertical-align: middle;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 0.875rem);
    line-height: 1.3;
    color: var(--color-foreground);
  }

  .comparison-table__cell--label {
    width: 34%;
    text-align: start;
    font-weight: var(--font-body--weight, 400);
  }

  .comparison-table__row--brands .comparison-table__cell {
    border-block-end: 0;
    padding-block-end: var(--gap-md);
  }

  .comparison-table__row--format .comparison-table__cell {
    font-weight: 600;
  }

  .comparison-table__row:last-child .comparison-table__cell {
    border-block-end: 0;
  }

  .comparison-table__cell--highlight {
    background-color: rgb(from var(--color-foreground) r g b / 6%);
  }

  .comparison-table__row--brands .comparison-table__cell--highlight {
    border-start-start-radius: var(--border-radius-sm, 4px);
    border-start-end-radius: var(--border-radius-sm, 4px);
  }

  .comparison-table__row:last-child .comparison-table__cell--highlight {
    border-end-start-radius: var(--border-radius-sm, 4px);
    border-end-end-radius: var(--border-radius-sm, 4px);
  }

  .comparison-table__logo {
    display: inline-block;
    width: var(--comparison-table-logo-width, 72px);
    max-width: 100%;
    height: auto;
    opacity: var(--comparison-table-logo-opacity, 1);
  }

  .comparison-table__brand-name {
    font-weight: 600;
  }

  .comparison-table__icon {
    display: inline-block;
    vertical-align: middle;
  }

  .comparison-table__icon--yes {
    color: var(--color-foreground);
  }

  .comparison-table__icon--no {
    color: var(--color-foreground);
    opacity: 0.35;
  }

  @media screen and (min-width: 750px) {
    .comparison-table__cell {
      padding-block: var(--gap-md);
      padding-inline: var(--gap-sm);
      font-size: var(--font-size--md, 1rem);
    }

    .comparison-table__cell--label {
      width: 28%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How We Compare"
    },
    {
      "type": "text",
      "id": "format_label",
      "label": "Format row label",
      "default": "Format"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FCF9F5"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Feature label",
          "default": "Feature"
        }
      ]
    },
    {
      "type": "brand",
      "name": "Brand column",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "logo_svg",
          "label": "Logo asset filename",
          "info": "Filename of an SVG in the theme assets folder. Used when no logo image is selected."
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Brand name",
          "default": "Brand"
        },
        {
          "type": "number",
          "id": "logo_width",
          "label": "Logo width (px)",
          "default": 72
        },
        {
          "type": "range",
          "id": "logo_opacity",
          "label": "Logo opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "textarea",
          "id": "format",
          "label": "Format",
          "default": "Liquid Pod"
        },
        {
          "type": "text",
          "id": "results",
          "label": "Results",
          "info": "Comma-separated yes/no values, one per feature row in order.",
          "default": "yes,yes,yes"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight column",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "feature", "settings": { "label": "Superior cleaning" } },
        { "type": "feature", "settings": { "label": "Plastic-free packaging" } },
        { "type": "feature", "settings": { "label": "Made in the USA" } },
        { "type": "brand", "settings": { "logo_alt": "Our brand", "format": "Liquid Pod", "results": "yes,yes,yes", "highlight": true } },
        { "type": "brand", "settings": { "logo_alt": "Other brand", "format": "Powder Pod", "results": "no,no,yes", "highlight": false } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
