{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>

      {% render 'cart-drawer-upsells', context: 'empty' %}
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            {% render 'theme-drawer-header',
              title: 'Your Cart',
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading'
            %}
          {%- else -%}
            {% capture cart_badge_html %}
              <span class="visually-hidden">
                {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
              </span>
            {% endcapture %}
            {% capture cart_drawer_title -%}
              Your Cart ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})
            {%- endcapture %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <div class="cart-drawer__summary">
                  {% render 'cart-drawer-summary', section_id: 'cart-drawer-section' %}
                </div>

                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                {% render 'cart-drawer-upsells', context: 'filled' %}
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>

        {% render 'cart-options-drawer' %}
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: 16px;
    --font-paragraph--line-height: 1;
    display: contents;
  }

  #cart-drawer .theme-drawer__dialog {
    --cart-drawer-surface: #fcf9f5;
    --cart-drawer-ink: #231f20;
    --cart-drawer-accent: #14495b;
    --cart-drawer-cta: #9bd7d7;
    --cart-drawer-upsell-bg: #e9ea6b;
    --cart-drawer-thumb-bg: #f1e8da;
    --cart-drawer-border: #e0e6ed;
    --cart-drawer-success: #5c856b;
    --cart-drawer-muted: #656363;
    --cart-drawer-divider: #8f928f;
    --cart-drawer-padding: 16px;

    background-color: #ffffff;
    color: var(--cart-drawer-ink);
  }

  #cart-drawer .theme-drawer__header {
    padding: 20px;
    background: var(--cart-drawer-surface);
    border-bottom: 1px solid var(--cart-drawer-thumb-bg);
    color: var(--cart-drawer-ink);
  }

  #cart-drawer .theme-drawer__header .theme-drawer__title {
    font-family: var(--font-subheading--family);
    font-size: 16px;
    line-height: 20px;
    font-weight: 600;
    color: var(--cart-drawer-ink);
  }

  #cart-drawer .theme-drawer__header .theme-drawer__close-button {
    --private-button-size: 24px;

    width: 24px;
    height: 24px;
    border: none;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
    color: var(--cart-drawer-ink);
  }

  #cart-drawer .theme-drawer__header .theme-drawer__close-button:hover:not(:active) {
    background: transparent;
    color: var(--cart-drawer-ink);
  }

  #cart-drawer .theme-drawer__header .theme-drawer__close-button .svg-wrapper,
  #cart-drawer .theme-drawer__header .theme-drawer__close-button svg {
    width: 24px;
    height: 24px;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background: #ffffff;
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px 16px 0;
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items {
    padding: 0;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: 24px;
    border-bottom: 1px solid #e0e6ed;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row + .cart-items__table-row {
    padding-top: 24px;
  }

  .cart-drawer-upsells {
    margin-top: auto;
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: 0;

    position: sticky;
    top: 0;
    bottom: auto;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    padding: 0 0 16px;
    margin-top: 0;
    background: #ffffff;
    border-bottom: 1px solid #e0e6ed;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)),
  .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
    border-block-start: none;
    padding-block-start: 0;
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content,
  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: stretch;
    justify-content: flex-start;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items,
  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    flex: 1 0 auto;
    justify-content: center;
    align-items: center;
    gap: 0;
    padding: 0;
    overflow: visible;
  }

  .cart-drawer--empty .cart-drawer__items .cart-items__wrapper--drawer-empty,
  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items .cart-items__wrapper--drawer-empty {
    width: 100%;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }
{% endstylesheet %}
