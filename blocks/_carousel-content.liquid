{% liquid
  assign slide_count = block.blocks.size
  assign icons_style = section.settings.icons_style

  assign slideshow_class = 'carousel-content spacing-style '
  if block.settings.background_color != blank
    render 'contrast-override', background_color: block.settings.background_color, section_id: block.id
    assign slideshow_class = slideshow_class | append: ' color-custom-' | append: block.id
  endif

  if section.settings.section_width == 'page-width'
    assign slideshow_gutters = 'start end'
    assign gutter_style = '--gutter-slide-width: var(--util-page-margin-offset);'
  else
    assign slideshow_gutters = null
    assign gutter_style = '--gutter-slide-width: 0px;'
  endif

  assign show_arrows = false
  if icons_style != 'none'
    assign show_arrows = true
  endif

  assign slide_position = block.settings.position
  if block.settings.height == 'fill'
    assign slide_position = 'stretch'
  endif

  assign columns_gap_mobile = section.settings.columns_gap_mobile | default: section.settings.columns_gap

  assign show_dots = false
  if section.settings.pagination == 'dots'
    assign show_dots = true
    assign slideshow_class = slideshow_class | append: ' carousel-content--dots'
  endif
-%}

{% capture controls_content %}
  {% if show_dots %}
    {% render 'slideshow-controls',
      style: 'dots',
      item_count: slide_count,
      show_arrows: false,
      icon_style: 'none',
      pagination_position: 'right'
    %}
  {% endif %}
{% endcapture %}

{% capture blocks_content %}
  {% content_for 'blocks' %}
{% endcapture %}

{% capture slideshow_style %}
  --carousel-columns: {{ section.settings.columns }};
  --carousel-mobile-columns: {{ section.settings.mobile_columns }};
  {% render 'gap-style', value: section.settings.columns_gap, name: 'carousel-gap' %}
  {% render 'gap-style', value: columns_gap_mobile, name: 'carousel-gap-mobile' %}
  {% render 'spacing-style', settings: block.settings %}
  {% render 'border-override', settings: block.settings %}
{% endcapture %}

<div
  class="force-full-width"
  style="{{ gutter_style }}"
>
  {% render 'slideshow',
    class: slideshow_class,
    style: slideshow_style,
    slides: blocks_content,
    show_arrows: show_arrows,
    icon_style: icons_style,
    icon_shape: section.settings.icons_shape,
    auto_hide_controls: false,
    infinite: false,
    initial_slide: 0,
    slide_count: slide_count,
    slide_position: slide_position,
    slideshow_gutters: slideshow_gutters,
    controls: controls_content,
    attributes: block.shopify_attributes
  %}
</div>

{% stylesheet %}
  .carousel-content slideshow-slides {
    --slideshow-gap: var(--carousel-gap-mobile, var(--carousel-gap));
  }

  .carousel-content slideshow-slides > .card {
    flex: 0 0 auto;
    width: calc(
      (
          100% - (var(--carousel-gap-mobile, var(--carousel-gap, 8px)) * (var(--carousel-mobile-columns, 2) - 1)) -
            var(--peek-next-slide-size, 0px)
        ) /
        var(--carousel-mobile-columns, 2)
    );
  }

  @media screen and (min-width: 750px) {
    .carousel-content slideshow-slides {
      --slideshow-gap: var(--carousel-gap);
    }

    .carousel-content slideshow-slides > .card {
      width: calc(
        (100% - (var(--carousel-gap, 8px) * (var(--carousel-columns, 4) - 1)) - var(--peek-next-slide-size, 0px)) /
          var(--carousel-columns, 4)
      );
    }
  }

  .carousel-content--dots slideshow-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-block-start: 32px;
    padding-inline: var(--util-page-margin-offset);
  }

  .carousel-content--dots slideshow-controls:has(> .slideshow-controls__dots) {
    mix-blend-mode: normal;
  }

  .carousel-content--dots .slideshow-controls__dots {
    gap: 6px;
    padding: 12px 16px;
    margin-inline: 0;
    margin-inline-start: auto;
    border-radius: 0;
  }

  .carousel-content--dots .slideshow-controls__dots button {
    --color: rgb(var(--color-foreground-rgb));
    --color-active: rgb(var(--color-foreground-rgb));
    --color-hover: rgb(var(--color-foreground-rgb));
  }

  .carousel-content--dots .slideshow-controls__dots button::after {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    box-shadow: none;
    transition: width 0.2s ease;
  }

  .carousel-content--dots .slideshow-controls__dots button[aria-selected='true']::after {
    width: 18px;
    box-shadow: none;
  }

  @media screen and (min-width: 750px) {
    .carousel-content--dots slideshow-controls {
      margin-block-start: 48px;
    }

    .carousel-content--dots .slideshow-controls__dots {
      gap: 8px;
      padding: 16px 24px;
    }

    .carousel-content--dots .slideshow-controls__dots button::after {
      width: 8px;
      height: 8px;
      border-radius: 4px;
    }

    .carousel-content--dots .slideshow-controls__dots button[aria-selected='true']::after {
      width: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-content--dots .slideshow-controls__dots button::after {
      transition: none;
    }
  }

  .carousel-content .slideshow-control[disabled] {
    display: none;
  }

  .carousel-content slideshow-arrows {
    padding-inline: var(--util-page-margin-offset);
  }

  .carousel-content .slideshow-control--next {
    margin-inline-start: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.carousel_content",
  "blocks": [
    {
      "type": "_card"
    },
    {
      "type": "_review-card"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.card_height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        }
      ],
      "visible_if": "{{ block.settings.height == \"fit\" }}",
      "default": "top"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.carousel_content",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
